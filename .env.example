SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=          # service_role, SOLO lato server (Vercel env), mai nel frontend
SESSION_SECRET=                # stringa casuale lunga per firmare il cookie
INIT_EMAIL=                    # email dell'utente di accesso
INIT_NOME=
INIT_PASSWORD=                 # solo per creare/reimpostare l'utente (npm run crea-utente); poi toglila
RESEND_API_KEY=                # invio email (opzionale finché non scelto il provider)
MAIL_FROM="Gettoniere-Shop <commerciale@gettoniere-shop.it>"
